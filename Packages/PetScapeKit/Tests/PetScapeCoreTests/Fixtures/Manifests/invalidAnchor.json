{
  "schemaVersion": 1,
  "id": "fixture",
  "displayName": "Fixture",
  "defaultAnimation": "walk",
  "canvas": { "width": 64, "height": 64 },
  "displaySize": { "width": 32, "height": 32 },
  "anchor": { "x": 1.5, "y": 0.1 },
  "animations": {
    "walk": { "fps": 8, "frames": [{ "image": "walk/walk_01.png" }] },
    "climb": { "fps": 8, "anchor": { "x": 0.5, "y": -0.1 }, "frames": [{ "image": "climb/climb_01.png" }] }
  }
}
