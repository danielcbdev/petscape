{
  "schemaVersion": 1,
  "id": "fixture",
  "displayName": "Fixture",
  "defaultAnimation": "walk",
  "canvas": { "width": 64, "height": 64 },
  "displaySize": { "width": 32, "height": 32 },
  "anchor": { "x": 0.5, "y": 0.1 },
  "animations": {
    "walk": { "fps": 8, "frames": [{ "image": "walk/walk_01.png" }] },
    "looping-next": { "fps": 8, "next": "walk", "frames": [{ "image": "sit/sit_01.png" }] },
    "missing-next": { "playback": "once", "fps": 8, "next": "dream", "frames": [{ "image": "nap/nap_01.png" }] }
  }
}
