    "Some character packs are unavailable because their files are invalid.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns pacotes de personagens estão indisponíveis porque seus arquivos são inválidos."
          }
        }
      }
    },
    "Some included characters are unavailable because their files are invalid.": {
