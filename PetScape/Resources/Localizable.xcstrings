{
  "sourceLanguage": "en",
  "strings": {
    "%@ — Included": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — Incluído"
          }
        }
      }
    },
    "%@ — Installed": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — Instalado"
          }
        }
      }
    },
    "+40 pt": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "+40 pt"
          }
        }
      }
    },
    "A character with this ID is already installed. PetScape never overwrites installed packs.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já há um personagem com este ID instalado. O PetScape nunca substitui pacotes instalados."
          }
        }
      }
    },
    "Accessibility permission is missing.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta a permissão de Acessibilidade."
          }
        }
      }
    },
    "Activities": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atividades"
          }
        }
      }
    },
    "Adjust the paws if they appear above or below the Dock.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste as patas se parecerem acima ou abaixo do Dock."
          }
        }
      }
    },
    "Advanced": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avançado"
          }
        }
      }
    },
    "Allow PetScape to use Accessibility?": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir que o PetScape use Acessibilidade?"
          }
        }
      }
    },
    "Allow click and drag": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir cliques e arraste"
          }
        }
      }
    },
    "Allow music detection?": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir a detecção de música?"
          }
        }
      }
    },
    "Animation Preview": {
      "comment": "DEBUG builds only: menu item that opens the animation preview window.",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pré-visualização das animações"
          }
        }
      }
    },
    "Approval required in System Settings › General › Login Items.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "É necessária aprovação em Ajustes do Sistema › Geral › Itens de Início de Sessão."
          }
        }
      }
    },
    "Autonomous activities": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atividades autônomas"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancelar"
          }
        }
      }
    },
    "Cat": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gato"
          }
        }
      }
    },
    "Character": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Personagem"
          }
        }
      }
    },
    "Character pack installed. Select it above to use it.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacote de personagem instalado. Selecione-o acima para usá-lo."
          }
        }
      }
    },
    "Choose a folder containing character.json and its referenced PNG files.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta com character.json e os arquivos PNG referenciados."
          }
        }
      }
    },
    "Click to get your pet's attention. Drag to pick it up. Pause stops interactions. Optional reactions follow system Reduce Motion.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique para chamar a atenção do pet. Arraste-o para pegá-lo. A pausa interrompe as interações. As reações opcionais respeitam a opção Reduzir Movimento do sistema."
          }
        }
      }
    },
    "Could not disable launch at login. Check System Settings and try again.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível desativar a abertura ao iniciar sessão. Confira os Ajustes do Sistema e tente novamente."
          }
        }
      }
    },
    "Could not enable launch at login. Check System Settings and try again.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ativar a abertura ao iniciar sessão. Confira os Ajustes do Sistema e tente novamente."
          }
        }
      }
    },
    "Dance": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dançar"
          }
        }
      }
    },
    "Dance and cleanup artwork is pending. Your pet holds a still pose during these activities.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As animações de dança e limpeza ainda não estão disponíveis. Durante essas atividades, o pet fica em uma pose parada."
          }
        }
      }
    },
    "Dance for 5–30 seconds. Requires an active pet with autonomous activities enabled.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dança por 5 a 30 segundos. Requer um pet ativo com as atividades autônomas ativadas."
          }
        }
      }
    },
    "Dance to music": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dançar ao som da música"
          }
        }
      }
    },
    "Debug": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuração"
          }
        }
      }
    },
    "Disabled": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado"
          }
        }
      }
    },
    "Dock offset": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste do Dock"
          }
        }
      }
    },
    "Dock offset: %lld pt": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajuste do Dock: %lld pt"
          }
        }
      }
    },
    "Enable Interact with windows in Settings.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative Interagir com janelas nos Ajustes."
          }
        }
      }
    },
    "Enable Music Detection": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativar detecção de música"
          }
        }
      }
    },
    "Enable autonomous activities, show and resume your pet, then wait until it is walking or idle.": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative as atividades autônomas, mostre e retome o pet e aguarde até ele estar andando ou parado."
          }
        }
      }
    },
    "Enabled": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado"
          }
        }
      }
    },
    "Expressions": {
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expressões"
          }
