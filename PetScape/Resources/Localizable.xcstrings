    "Music detection is paused while your pet is unavailable or autonomous activities are off." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A detecção de música fica pausada enquanto o pet não está disponível ou as atividades autônomas estão desativadas."
          }
        }
      }
    },
    "Music detection stopped. Check PetScape under System Audio Recording in Privacy & Security and your output device, then restart music detection. Manual dance remains available." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A detecção de música parou. Confira se o PetScape tem permissão para gravar áudio do sistema em Privacidade e Segurança e verifique o dispositivo de saída; depois, reinicie a detecção. A dança manual continua disponível."
          }
        }
      }
    },
    "No bundled characters are available." : {
      "localizations" : {
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nenhum personagem incluído está disponível."
          }
        }
      }
    },
